// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id             String     @id @default(cuid())
  name           String
  code           String     @unique
  address        String
  latitude       Float?
  longitude      Float?
  geofenceRadius Int        @default(100)
  timezone       String     @default("Asia/Singapore")
  status         SiteStatus @default(ACTIVE)
  assignedGuards Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  siteClients    SiteClient[]
  userSites      UserSite[]
}

model User {
  id                    String     @id @default(cuid())
  fullName              String
  employeeId            String     @unique
  company               String     @default("fuad")
  nric                  String?
  passwordHash          String
  passwordChangedAt     DateTime   @default(now())
  profileImageUrl       String?
  dateOfBirth           DateTime?
  nationality           String
  gender                String?
  race                  String?
  religion              String?
  phone                 String
  email                 String?
  nfcCode               String?
  address               String?
  role                  String
  secondaryRole         String?
  insurancePlan         String?
  primaryNokName        String?
  primaryNokRelationship String?
  primaryNokLanguage    String?
  primaryNokPhone       String?
  secondaryNokName      String?
  secondaryNokRelationship String?
  secondaryNokLanguage  String?
  secondaryNokPhone     String?
  vaccinated            Boolean?
  bypassGpsGeofence     Boolean    @default(false)
  deploymentSiteId      String?
  status                UserStatus @default(ACTIVE)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  sites                 UserSite[]
  employmentRecords     EmploymentRecord[]
  pwmHistory            PwmEmploymentHistory[]
}

model EmploymentRecord {
  id               String   @id @default(cuid())
  userId           String
  dateJoin         DateTime
  dateLeft         DateTime?
  probationPeriod  String?
  noticePeriod     String?
  status           String
  notificationDate DateTime?
  confirmationDate DateTime?
  remarks          String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PwmEmploymentHistory {
  id            String   @id @default(cuid())
  userId        String
  role          String
  roleStartDate DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployeeRecord {
  id               String   @id @default(cuid())
  employeeId       String?
  dateJoin         DateTime
  dateLeft         DateTime?
  probationPeriod  String?
  noticePeriod     String?
  status           String
  notificationDate DateTime?
  confirmationDate DateTime?
  remarks          String?
  createdAt        DateTime @default(now())

  @@index([employeeId])
}

model PwmEmploymentRecord {
  id            String   @id @default(cuid())
  employeeId    String?
  role          String
  roleStartDate DateTime
  createdAt     DateTime @default(now())

  @@index([employeeId])
}

model AttendanceRecord {
  id                  String   @id @default(cuid())
  employeeId          String
  employeeName        String
  siteId              String?
  siteName            String?
  siteCode            String?
  shiftDate           DateTime
  shiftStart          String
  shiftEnd            String
  shiftType           String?
  checkInAt           DateTime?
  checkOutAt          DateTime?
  checkInLatitude     Float?
  checkInLongitude    Float?
  checkOutLatitude    Float?
  checkOutLongitude   Float?
  checkInImageUrl     String?
  checkOutImageUrl    String?
  status              AttendanceStatus @default(COMPLETED)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([employeeId])
  @@index([shiftDate])
}

model UserSite {
  userId     String
  siteId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

model Client {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  createdAt   DateTime     @default(now())
  siteClients SiteClient[]
}

model SiteClient {
  siteId     String
  clientId   String
  assignedAt DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([siteId, clientId])
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  ON_DUTY
  COMPLETED
  ABSENT
}
